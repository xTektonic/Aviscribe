<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="xTektonic local" value=".local/nuget/0.1.0-beta.2" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="xTektonic local">
      <package pattern="SMOVision.*" />
      <package pattern="FlashCap" />
      <package pattern="FlashCap.Core" />
      <package pattern="PipeWire.NET" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".local/packages/0.1.0-beta.2" />
  </config>
</configuration>
