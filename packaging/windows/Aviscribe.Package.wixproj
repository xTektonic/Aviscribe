<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>Aviscribe-$(AppVersion)-win-x64</OutputName>
    <AppVersion Condition="'$(AppVersion)' == ''">0.6.0</AppVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>
      PublishDir=$(PublishDir);
      AppVersion=$(AppVersion)
    </DefineConstants>
  </PropertyGroup>
</Project>
