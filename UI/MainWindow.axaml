<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="Aviscribe.UI.MainWindow"
        Width="1000" Height="600"
        Title="Aviscribe">

	<Grid ColumnDefinitions="320,320,*">

		<!-- LEFT: Controls -->
		<ScrollViewer>
		<StackPanel Margin="12" Spacing="10">

			<TextBlock Text="Run" FontSize="18" FontWeight="SemiBold"/>

			<TextBlock Text="Kingdom"/>
			<ComboBox Name="cbKingdomSelect"/>

			<TextBlock Text="Category"/>
			<ComboBox Name="cbCategorySelect"/>

			<TextBlock Text="Game Text Language"/>
			<ComboBox Name="cbInputLanguageSelect"/>

			<TextBlock Text="Display Language"/>
			<ComboBox Name="cbOutputLanguageSelect"/>

			<CheckBox Name="chkIncludePostGame" Content="Include postgame kingdoms"/>

			<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>

			<TextBlock Text="Video Source"/>

			<ComboBox Name="cbInputSelect"/>

			<Button Name="btnUpdatePreview" Content="Start / Update Preview"/>

			<TextBlock Name="txtStatus" Text="Ready" TextWrapping="Wrap"/>

			<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>

			<TextBlock Text="Overlay Output" FontWeight="SemiBold"/>
			<CheckBox Name="chkWriteOverlay" Content="Write pending moons to file"/>
			<TextBox Name="txtOverlayPath"/>

			<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>

			<TextBlock Text="Manual Correction" FontWeight="SemiBold"/>
			<ComboBox Name="cbMoonSelect"/>
			<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
				<Button Name="btnManualPending" Content="Pending"/>
				<Button Name="btnManualCollected" Grid.Column="1" Content="Collected"/>
				<Button Name="btnManualUncounted" Grid.Column="2" Content="Wrong"/>
				<Button Name="btnManualRemove" Grid.Row="1" Grid.ColumnSpan="2" Content="Remove Selected"/>
				<Button Name="btnResetKingdom" Grid.Row="1" Grid.Column="2" Content="Reset"/>
			</Grid>

			<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>

			<TextBlock Text="Needs Review" FontWeight="SemiBold"/>
			<TextBlock Name="txtReviewPrompt" Text="No ambiguous reads" TextWrapping="Wrap"/>
			<ComboBox Name="cbReviewSelect"/>
			<Grid ColumnDefinitions="*,*" ColumnSpacing="6">
				<Button Name="btnReviewApply" Content="Use Selected"/>
				<Button Name="btnReviewDismiss" Grid.Column="1" Content="Dismiss"/>
			</Grid>

			<Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4"/>

			<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2">
				<TextBlock Text="Counted" FontWeight="SemiBold"/>
				<TextBlock Grid.Column="1" Text="Actual" FontWeight="SemiBold"/>
				<TextBlock Name="txtCountedCount" Grid.Row="1" FontSize="24"/>
				<TextBlock Name="txtActualCount" Grid.Row="1" Grid.Column="1" FontSize="24"/>
			</Grid>

		</StackPanel>
		</ScrollViewer>

		<!-- MIDDLE: Kingdom moon list -->
		<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="10">
			<TextBlock Text="Kingdom Moons" FontSize="18" FontWeight="SemiBold"/>
			<ListBox Name="lstMoonList" Grid.Row="1"/>
		</Grid>

		<!-- RIGHT: Preview and run state -->
		<Grid Grid.Column="2" RowDefinitions="2*,Auto,*" Margin="10" RowSpacing="10">
			<Border Background="Black">
				<Image Name="imgPreview" Stretch="Uniform"/>
			</Border>

			<TextBlock Grid.Row="1" Text="Run State" FontSize="18" FontWeight="SemiBold"/>

			<Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
				<StackPanel Spacing="6">
					<TextBlock Text="Pending" FontWeight="SemiBold"/>
					<ListBox Name="lstPending"/>
				</StackPanel>

				<StackPanel Grid.Column="1" Spacing="6">
					<TextBlock Text="Counted Moons" FontWeight="SemiBold"/>
					<ListBox Name="lstCollected"/>
				</StackPanel>

				<StackPanel Grid.Column="2" Spacing="6">
					<TextBlock Text="Uncounted / Wrong Moons" FontWeight="SemiBold"/>
					<ListBox Name="lstUncounted"/>
				</StackPanel>
			</Grid>
		</Grid>

	</Grid>
</Window>
