<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aviscribe</AssemblyName>
    <RootNamespace>Aviscribe.Desktop</RootNamespace>
    <ApplicationTitle>Aviscribe</ApplicationTitle>
    <ApplicationId>io.github.xtektonic.aviscribe</ApplicationId>
    <RuntimeIdentifiers>win-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aviscribe.Capture\Aviscribe.Capture.csproj" />
    <ProjectReference Include="..\Aviscribe.Core\Aviscribe.Core.csproj" />
    <ProjectReference Include="..\Aviscribe.UI\Aviscribe.UI.csproj" />
  </ItemGroup>
</Project>
