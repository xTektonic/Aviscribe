<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Aviscribe.UI"
        x:Class="Aviscribe.UI.GameplayCropWindow"
        Width="1220" Height="820"
        MinWidth="900" MinHeight="620"
        Icon="avares://Aviscribe.UI/Assets/aviscribe-icon.png"
        Title="Crop Gameplay">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3">
        <TextBlock Classes="eyebrow" Text="CAPTURE SETUP"/>
        <TextBlock Classes="pageTitle" Text="Gameplay crop"/>
        <TextBlock Classes="bodyMuted" Text="Drag the frame or its handles. The selection stays 16:9 for accurate OCR."/>
      </StackPanel>
      <CheckBox Name="chkShowGuides" Grid.Column="1" Content="Show scan areas"
                IsChecked="True" VerticalAlignment="Center"
                ToolTip.Tip="Show every gameplay area Aviscribe checks for text and automatic kingdom detection."/>
      <Button Name="btnRefreshFrame" Grid.Column="2" Content="Refresh Frame"
              VerticalAlignment="Center" MinWidth="120"
              ToolTip.Tip="Request a new uncropped frame from the active capture source."/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,270" ColumnSpacing="16">
      <Border Background="Black" CornerRadius="8" ClipToBounds="True">
        <local:CropSelectionControl Name="cropCanvas" Focusable="True"/>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="sectionTitle" Text="Fine tune"/>
          <TextBlock Name="txtSourceSize" Text="Waiting for a frame..." Classes="caption"/>

          <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="8" RowSpacing="8">
            <TextBlock Text="X" VerticalAlignment="Center"
                       ToolTip.Tip="Horizontal position of the crop's left edge."/>
            <NumericUpDown Name="numCropX" Grid.Column="1" Minimum="0" Increment="1"
                           FormatString="0"/>
            <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center"
                       ToolTip.Tip="Vertical position of the crop's top edge."/>
            <NumericUpDown Name="numCropY" Grid.Row="1" Grid.Column="1" Minimum="0"
                           Increment="1" FormatString="0"/>
            <TextBlock Grid.Row="2" Text="Width" VerticalAlignment="Center"
                       ToolTip.Tip="Width of the selected gameplay area in source pixels."/>
            <NumericUpDown Name="numCropWidth" Grid.Row="2" Grid.Column="1" Minimum="16"
                           Increment="16" FormatString="0"/>
            <TextBlock Grid.Row="3" Text="Height" VerticalAlignment="Center"
                       ToolTip.Tip="Height of the selected gameplay area in source pixels."/>
            <NumericUpDown Name="numCropHeight" Grid.Row="3" Grid.Column="1" Minimum="9"
                           Increment="9" FormatString="0"/>
          </Grid>

          <TextBlock Classes="caption" Text="Arrow keys move 1 px; hold Shift for 10 px."
                     TextWrapping="Wrap"/>
          <Button Name="btnResetCrop" Content="Reset to Full Frame"
                  ToolTip.Tip="Restore the largest centered 16:9 crop for this source."/>

          <Separator/>
          <TextBlock Text="Guide colors" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="12" Height="12" Background="#FFBE46" CornerRadius="2"/>
            <TextBlock Text="Talkatoo"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="12" Height="12" Background="#41CDFF" CornerRadius="2"/>
            <TextBlock Text="Moon Get"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="12" Height="12" Background="#FF5FBE" CornerRadius="2"/>
            <TextBlock Text="Story Moon"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="12" Height="12" Background="#75E086" CornerRadius="2"/>
            <TextBlock Text="Kingdom HUD"/>
          </StackPanel>
          <TextBlock Classes="caption"
                     Text="Thin outlines show detection areas. Bold outlines show text sent to OCR."
                     TextWrapping="Wrap"/>

          <TextBlock Name="txtCropStatus" Text="Refresh the frame to begin."
                     TextWrapping="Wrap" Classes="caption"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="caption" Text="Changes take effect only when you choose Apply."
                 VerticalAlignment="Center"/>
      <Button Name="btnCancel" Grid.Column="1" Content="Cancel" MinWidth="90"/>
      <Button Name="btnApply" Grid.Column="2" Classes="primary" Content="Apply" MinWidth="90"
              IsDefault="True"/>
    </Grid>
  </Grid>
</Window>
