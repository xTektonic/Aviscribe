<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aviscribe.UI.OnlineRunWindow"
        Title="Online Run"
        Width="760" Height="680"
        MinWidth="650" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Classes="pageTitle" Text="Online Run"/>
        <TextBlock Name="txtOnlineStatus" Classes="bodyMuted" Text="Offline" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Name="btnClose" Grid.Column="1" Content="Close" VerticalAlignment="Top"/>
    </Grid>

    <Border Grid.Row="1" Classes="soft">
      <TextBlock Name="txtOnlineMessage" Classes="caption" Text="Connect to a SMOO+ server to share run state." TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <StackPanel Name="pnlDisconnected" Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Server"/>
              <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="ADDRESS"/>
                  <TextBox Name="txtServerAddress" PlaceholderText="example.com"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="caption" Text="PORT"/>
                  <TextBox Name="txtServerPort" Text="1027"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Classes="caption" Text="YOUR DISPLAY NAME"/>
                <TextBox Name="txtDisplayName" MaxLength="32"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="Start a new run"/>
                <TextBlock Classes="bodyMuted" Text="Creates a blank shared run and gives you a join code." TextWrapping="Wrap"/>
                <Button Name="btnCreateRun" Classes="primary" Content="Create Run" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="Join a run"/>
                <TextBox Name="txtJoinCode" PlaceholderText="XXXX-XXXX" MaxLength="9"/>
                <Button Name="btnJoinRun" Classes="primary" Content="Join" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </Grid>
          <Button Name="btnResumeRun" Content="Resume previous online run" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Name="pnlConnected" IsVisible="False" Spacing="14">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Classes="caption" Text="JOIN CODE"/>
                <TextBlock Name="txtConnectedCode" Classes="metric" Text="—"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="caption" Text="CAPTURE SHARING"/>
                <TextBlock Name="txtCaptureSharing" FontWeight="SemiBold" Text="Paused"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                <TextBlock Classes="caption" Text="CURRENT OWNER"/>
                <TextBlock Name="txtOwner" FontWeight="SemiBold" Text="—"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="0.8*,1.2*" ColumnSpacing="12">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Classes="sectionTitle" Text="Participants"/>
                <ListBox Name="lstOnlineParticipants" Grid.Row="1" MinHeight="160"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Classes="sectionTitle" Text="Recent activity"/>
                <ListBox Name="lstOnlineEvents" Grid.Row="1" MinHeight="160"/>
              </Grid>
            </Border>
          </Grid>

          <Border Name="pnlOwnerControls" Classes="card" IsVisible="False">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Owner controls"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <ComboBox Name="cbOnlineCategory"/>
                <CheckBox Name="chkOnlinePostgame" Grid.Column="1" Content="Include postgame" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="btnOnlineReset" Content="Reset Run" Classes="danger"/>
                <Button Name="btnOnlineEnd" Content="End Run" Classes="danger"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Button Name="btnOnlineLeave" Content="Leave Run" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
