<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aviscribe.UI.MainWindow"
        Width="1380" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowState="Maximized"
        Title="Aviscribe">

	<Window.Styles>
		<Style Selector="Border.panel">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="8"/>
		</Style>
		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.metric">
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="ListBox.runList">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="ListBox.runList > ListBoxItem">
			<Setter Property="Padding" Value="4,1"/>
			<Setter Property="MinHeight" Value="22"/>
		</Style>
		<Style Selector="Button.commandButton">
			<Setter Property="MinWidth" Value="78"/>
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="8,3"/>
		</Style>
	</Window.Styles>

	<TabControl Name="tabMain">
		<TabItem Header="Run">
			<Grid Margin="10" RowDefinitions="Auto,*,Auto" RowSpacing="8">
				<Border Classes="panel">
					<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
						<Grid ColumnDefinitions="190,Auto,Auto,Auto,*" ColumnSpacing="6">
							<ComboBox Name="cbKingdomSelect" VerticalAlignment="Center"/>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
								<TextBlock Text="Requirement" FontSize="11" Opacity="0.65"/>
								<TextBlock Name="txtRequirement" Text="0" FontWeight="SemiBold"/>
							</StackPanel>
							<StackPanel Grid.Column="2" Margin="0,0,8,0">
								<TextBlock Text="Counted" FontSize="11" Opacity="0.65"/>
								<TextBlock Name="txtCountedCount" Classes="metric" Text="0"/>
							</StackPanel>
							<StackPanel Grid.Column="3">
								<TextBlock Text="Actual" FontSize="11" Opacity="0.65"/>
								<TextBlock Name="txtActualCount" Classes="metric" Text="0"/>
							</StackPanel>
							<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
										VerticalAlignment="Center" HorizontalAlignment="Right">
								<Button Name="btnUpdatePreview" Content="Start / Update" ToolTip.Tip="Start capture using the selected source"/>
								<Button Name="btnResetKingdom" Content="Reset Run" ToolTip.Tip="Clear all kingdoms and ambiguous reviews"/>
							</StackPanel>
						</Grid>

						<Grid Grid.Row="1" ColumnDefinitions="82,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
							<TextBox Name="txtMoonNumber" Width="82" PlaceholderText="Moon #"
									 AcceptsReturn="False" VerticalAlignment="Top"
									 ToolTip.Tip="Use the configured hotkey, type a moon number, then choose its destination"/>
							<Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
								  ColumnSpacing="4" RowSpacing="4">
								<Button Name="btnCommandPending" Classes="commandButton" Content="Pending" ToolTip.Tip="Move moon number to pending"/>
								<Button Name="btnCommandCollected" Grid.Column="1" Classes="commandButton" Content="Counted" ToolTip.Tip="Move moon number to counted"/>
								<Button Name="btnCommandWrong" Grid.Row="1" Classes="commandButton" Content="Wrong" ToolTip.Tip="Move moon number to wrong/uncounted"/>
								<Button Name="btnCommandRemove" Grid.Row="1" Grid.Column="1" Classes="commandButton" Content="Remove" ToolTip.Tip="Remove moon number from run state"/>
							</Grid>
						</Grid>
					</Grid>
				</Border>

				<Grid Grid.Row="1" ColumnDefinitions="1.7*,0.9*,1.1*" ColumnSpacing="8">
					<Border Classes="panel" BorderBrush="#D89B28">
						<Grid RowDefinitions="Auto,*" RowSpacing="8">
							<TextBlock Classes="sectionTitle" Text="Pending"/>
							<ListBox Name="lstPending" Grid.Row="1" Classes="runList">
								<ListBox.ItemTemplate>
									<DataTemplate x:CompileBindings="False">
										<StackPanel Orientation="Horizontal" Spacing="10">
											<Border Width="250" Height="141" CornerRadius="4" ClipToBounds="True"
													IsVisible="{Binding HasImage}" Background="Black">
												<Image Source="{Binding Image}" Stretch="UniformToFill"/>
											</Border>
											<TextBlock Text="{Binding Label}" TextWrapping="Wrap"
													   VerticalAlignment="Center" MaxWidth="280"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
					</Border>

					<Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="8">
						<Border Classes="panel" BorderBrush="#3B9B62">
							<Grid RowDefinitions="Auto,*" RowSpacing="8">
								<TextBlock Classes="sectionTitle" Text="Counted Moons"/>
								<ListBox Name="lstCollected" Grid.Row="1" Classes="runList"/>
							</Grid>
						</Border>

						<Border Grid.Row="1" Classes="panel" BorderBrush="#B45C5C">
							<Grid RowDefinitions="Auto,*" RowSpacing="8">
								<TextBlock Classes="sectionTitle" Text="Wrong / Uncounted"/>
								<ListBox Name="lstUncounted" Grid.Row="1" Classes="runList"/>
							</Grid>
						</Border>
					</Grid>

					<Grid Grid.Column="2" RowDefinitions="3*,2*" RowSpacing="8">
						<Border Classes="panel">
							<Grid RowDefinitions="Auto,*" RowSpacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Classes="sectionTitle" Text="Kingdom Moons"/>
									<TextBlock Grid.Column="1" Name="txtMoonCount" Opacity="0.65"/>
								</Grid>
								<ListBox Name="lstMoonList" Grid.Row="1" Classes="runList" SelectionMode="Multiple"/>
							</Grid>
						</Border>

						<Border Grid.Row="1" Classes="panel">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
								<TextBlock Classes="sectionTitle" Text="Needs Review"/>
								<TextBlock Name="txtReviewPrompt" Grid.Row="1" Text="No ambiguous reads" TextWrapping="Wrap"/>
								<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
									<ComboBox Name="cbReviewSelect"/>
									<Button Name="btnReviewApply" Grid.Column="1" Content="Use"/>
									<Button Name="btnReviewDismiss" Grid.Column="2" Content="Dismiss"/>
								</Grid>
							</Grid>
						</Border>
					</Grid>
				</Grid>

				<Grid Grid.Row="2">
					<TextBlock Name="txtCommandFeedback" Text="Ready" Opacity="0.7" VerticalAlignment="Center"/>
				</Grid>

				<ComboBox Name="cbMoonSelect" IsVisible="False"/>
				<Button Name="btnManualPending" IsVisible="False"/>
				<Button Name="btnManualCollected" IsVisible="False"/>
				<Button Name="btnManualUncounted" IsVisible="False"/>
				<Button Name="btnManualRemove" IsVisible="False"/>
			</Grid>
		</TabItem>

		<TabItem Header="Settings">
			<ScrollViewer>
				<Grid Margin="20" ColumnDefinitions="*,*" ColumnSpacing="18" MaxWidth="1050" HorizontalAlignment="Left">
					<StackPanel Spacing="18">
						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="Run Settings"/>
								<TextBlock Text="Category"/>
								<ComboBox Name="cbCategorySelect"/>
								<CheckBox Name="chkIncludePostGame" Content="Include postgame kingdoms"/>
								<CheckBox Name="chkAutomaticallySwitchKingdoms"
										  Content="Automatically switch kingdoms from the HUD"
										  ToolTip.Tip="Uses the regional-coin symbol when the gameplay HUD is visible. Unsupported kingdoms still require manual selection."/>
								<CheckBox Name="chkShowPendingImages" Content="Show images for pending moons"/>
							</StackPanel>
						</Border>

						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="Route Order"/>
								<CheckBox Name="chkWoodedBeforeLake" Content="Wooded before Lake"/>
								<CheckBox Name="chkSeasideBeforeSnow" Content="Seaside before Snow"/>
							</StackPanel>
						</Border>

						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="Language"/>
								<TextBlock Text="Game text language"/>
								<ComboBox Name="cbInputLanguageSelect"/>
								<TextBlock Text="OCR input currently supports Traditional Chinese. Simplified Chinese is temporarily disabled."
										   FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
								<TextBlock Text="Display language"/>
								<ComboBox Name="cbOutputLanguageSelect"/>
							</StackPanel>
						</Border>

						<Border Classes="panel">
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="Hotkeys"/>
								<Grid ColumnDefinitions="*,150" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
									  ColumnSpacing="10" RowSpacing="6">
									<TextBlock Text="Focus moon number" VerticalAlignment="Center"/>
									<ComboBox Name="cbFocusMoonHotkey" Grid.Column="1"/>
									<TextBlock Grid.Row="1" Text="Move to pending" VerticalAlignment="Center"/>
									<ComboBox Name="cbPendingHotkey" Grid.Row="1" Grid.Column="1"/>
									<TextBlock Grid.Row="2" Text="Move to counted" VerticalAlignment="Center"/>
									<ComboBox Name="cbCountedHotkey" Grid.Row="2" Grid.Column="1"/>
									<TextBlock Grid.Row="3" Text="Move to wrong" VerticalAlignment="Center"/>
									<ComboBox Name="cbWrongHotkey" Grid.Row="3" Grid.Column="1"/>
									<TextBlock Grid.Row="4" Text="Remove moon" VerticalAlignment="Center"/>
									<ComboBox Name="cbRemoveHotkey" Grid.Row="4" Grid.Column="1"/>
								</Grid>
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="1" Spacing="18">
						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="Capture Source"/>
								<TextBlock Text="Selected source"/>
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<Border Background="#22000000" CornerRadius="4" Padding="10,7">
										<TextBlock Name="txtSelectedCaptureSource" Text="No capture source selected" TextWrapping="Wrap"/>
									</Border>
									<Button Name="btnChooseCaptureSource" Grid.Column="1" Content="Choose Capture Source…"/>
								</Grid>
								<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
									<Button Name="btnSettingsUpdatePreview" Content="Start / Update Capture"/>
									<Button Name="btnCropGameplay" Grid.Column="1" Content="Crop Gameplay…"/>
								</Grid>
								<TextBlock Name="txtCropSummary" Text="Crop: Full frame (1920 × 1080)"
										   Opacity="0.7" TextWrapping="Wrap"/>
								<Border Height="240" Background="Black" CornerRadius="4">
									<Image Name="imgPreview" Stretch="Uniform"/>
								</Border>
							</StackPanel>
						</Border>

						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="OBS Overlay Output"/>
								<CheckBox Name="chkWriteOverlay" Content="Write pending moons to file"/>
								<TextBlock Text="Output path"/>
								<TextBox Name="txtOverlayPath"/>
							</StackPanel>
						</Border>

						<Border Classes="panel">
							<StackPanel Spacing="10">
								<TextBlock Classes="sectionTitle" Text="Diagnostics"/>
								<TextBlock Text="OCR processor"/>
								<ComboBox Name="cbOcrModeSelect"
										  ToolTip.Tip="WebGPU accelerates supported nodes and safely falls back to CPU on failure."/>
								<CheckBox Name="chkDebugLogging"
										  Content="Enable debug logging"
										  ToolTip.Tip="Adds detailed operational events; captured frames are never saved."/>
								<Button Name="btnOpenDiagnostics"
										Content="Open Diagnostics"
										HorizontalAlignment="Left"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>
			</ScrollViewer>
		</TabItem>
	</TabControl>
</Window>
