<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aviscribe.UI.DiagnosticsWindow"
        Width="760" Height="640"
        MinWidth="620" MinHeight="480"
        Title="Aviscribe Diagnostics"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold"/>
      <Button Name="btnRefreshDiagnostics" Grid.Column="1" Content="Refresh"/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="10" RowSpacing="5">
      <TextBlock Text="Application"/>
      <TextBlock Name="txtApplication" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Text="Runtime"/>
      <TextBlock Name="txtRuntime" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="2" Text="Capture device"/>
      <TextBlock Name="txtCaptureDevice" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="3" Text="Capture state / format"/>
      <TextBlock Name="txtCaptureState" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="4" Text="Source / active crop"/>
      <TextBlock Name="txtSourceCrop" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="5" Text="Log directory"/>
      <TextBlock Name="txtLogDirectory" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="Recent log entries" FontWeight="SemiBold"/>
      <TextBox Name="txtRecentLogs" Grid.Row="1"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas,Menlo,monospace"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right">
      <Button Name="btnOpenLogFolder" Content="Open log folder"/>
      <Button Name="btnCloseDiagnostics" Content="Close"/>
    </StackPanel>
  </Grid>
</Window>
