<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aviscribe.UI.DiagnosticsWindow"
        Width="780" Height="680"
        MinWidth="620" MinHeight="500"
        Title="Aviscribe Diagnostics"
        Icon="avares://Aviscribe.UI/Assets/aviscribe-icon.png"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="3">
        <TextBlock Classes="eyebrow" Text="TROUBLESHOOTING"/>
        <TextBlock Classes="pageTitle" Text="Diagnostics"/>
      </StackPanel>
      <Button Name="btnRefreshDiagnostics" Grid.Column="1" Content="Refresh"
              VerticalAlignment="Center" ToolTip.Tip="Refresh capture, OCR, and log information."/>
    </Grid>

    <Border Grid.Row="1" Classes="card compact">
      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="12" RowSpacing="6">
        <TextBlock Classes="caption" Text="Version"/>
        <TextBlock Name="txtVersion" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Classes="caption" Text="Application"/>
        <TextBlock Name="txtApplication" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Classes="caption" Text="Runtime"/>
        <TextBlock Name="txtRuntime" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Classes="caption" Text="Capture device"/>
        <TextBlock Name="txtCaptureDevice" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="4" Classes="caption" Text="Capture state / format"/>
        <TextBlock Name="txtCaptureState" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="5" Classes="caption" Text="Source / active crop"/>
        <TextBlock Name="txtSourceCrop" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="6" Classes="caption" Text="Requested OCR mode"/>
        <TextBlock Name="txtRequestedOcrMode" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="7" Classes="caption" Text="Active OCR provider"/>
        <TextBlock Name="txtActiveOcrProvider" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="8" Classes="caption" Text="Log directory"/>
        <TextBlock Name="txtLogDirectory" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
      <TextBlock Classes="sectionTitle" Text="Recent log entries"/>
      <TextBox Name="txtRecentLogs" Grid.Row="1"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas,Menlo,monospace"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right">
      <Button Name="btnOpenLogFolder" Content="Open Log Folder"
              ToolTip.Tip="Open the folder containing Aviscribe diagnostic logs."/>
      <Button Name="btnCloseDiagnostics" Classes="primary" Content="Close"/>
    </StackPanel>
  </Grid>
</Window>
