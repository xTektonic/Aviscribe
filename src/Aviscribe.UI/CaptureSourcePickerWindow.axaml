<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aviscribe.UI.CaptureSourcePickerWindow"
        x:CompileBindings="False"
        Title="Choose Capture Source"
        Width="560" Height="500"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Choose a capture source"/>
      <TextBlock Opacity="0.7" Text="Select a video device or application window."/>
    </StackPanel>
    <ListBox Name="lstCaptureSources" Grid.Row="1">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="110,*" Margin="6">
            <TextBlock Text="{Binding KindLabel}" Opacity="0.65" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Opacity="0.55" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Name="txtEmptySources" VerticalAlignment="Center" Opacity="0.7"
                 Text="No compatible capture sources were found." IsVisible="False"/>
      <Button Name="btnCancel" Grid.Column="1" Content="Cancel"/>
      <Button Name="btnChoose" Grid.Column="2" Content="Choose" IsDefault="True"/>
    </Grid>
  </Grid>
</Window>
